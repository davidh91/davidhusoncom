# Copy this file to `.env` and fill in the real values.
# `.env` is git-ignored. Never commit it.
#
# NOTE: Create React App inlines every REACT_APP_* variable into the public
# JavaScript bundle. These values are therefore visible to anyone who loads
# the site. Never put a private key, an API secret or a password here.
# Protect these identifiers with origin restrictions in each provider's
# dashboard instead (see README.md).

# EmailJS (public identifiers - restrict by allowed origin in the EmailJS dashboard)
REACT_APP_SERVICE_ID=
REACT_APP_TEMPLATE_ID=
REACT_APP_PUBLIC_KEY=

# reCAPTCHA v2 site key (restrict to your domains in the reCAPTCHA admin console)
REACT_APP_SITE_KEY=

# Keep the webpack runtime in an external file so the Content-Security-Policy
# in public/index.html does not need 'unsafe-inline' for scripts.
INLINE_RUNTIME_CHUNK=false
