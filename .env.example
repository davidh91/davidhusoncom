# Copy this file to `.env` and fill in the real values.
# `.env` is git-ignored. Never commit it.
#
# NOTE: Vite inlines every VITE_* variable into the public JavaScript
# bundle. These values are therefore visible to anyone who loads
# the site. Never put a private key, an API secret or a password here.
# Protect these identifiers with origin restrictions in each provider's
# dashboard instead (see README.md).

# EmailJS (public identifiers - restrict by allowed origin in the EmailJS dashboard)
VITE_SERVICE_ID=
VITE_TEMPLATE_ID=
VITE_PUBLIC_KEY=

# reCAPTCHA v2 site key (restrict to your domains in the reCAPTCHA admin console)
VITE_SITE_KEY=
